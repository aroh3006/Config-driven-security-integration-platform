# Copy to .env and fill in. Never commit .env.
# A config names a secret (okta_key). The value comes from the upper-case env var (OKTA_KEY).

OKTA_KEY=
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_TOKEN=
NVD_KEY=
SLACK_WEBHOOK=

# Mock server values, printed by the mock at startup
MOCK_FIREWALL_KEY=
MOCK_EDR_CLIENT_ID=
MOCK_EDR_CLIENT_SECRET=
MOCK_CLOUD_KEY=
MOCK_OKTA_KEY=
MOCK_GITHUB_TOKEN=
MOCK_JIRA_EMAIL=
MOCK_JIRA_TOKEN=

# Optional. Defaults to integration.db in the repo root.
INTEGRATION_DB=
